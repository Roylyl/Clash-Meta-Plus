<?xml version="1.0" encoding="utf-8"?>
<layout>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingTop="@dimen/large_item_padding_vertical"
        android:paddingBottom="@dimen/large_item_padding_vertical">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_glass_icon"
            android:importantForAccessibility="no">
            <View
                android:id="@+id/icon_view"
                android:layout_width="@dimen/large_item_header_component_size"
                android:layout_height="@dimen/large_item_header_component_size"
                android:layout_gravity="center"
                android:backgroundTint="?attr/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ClashGlass.Body"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/subtext_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/large_item_text_margin"
                android:textAppearance="@style/TextAppearance.ClashGlass.Caption" />
        </LinearLayout>
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ic_glass_chevron"
            android:importantForAccessibility="no" />
    </LinearLayout>
</layout>
