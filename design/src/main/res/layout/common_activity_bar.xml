<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/toolbar_height"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/activity_bar_close_view"
        android:layout_width="@dimen/glass_touch_target"
        android:layout_height="@dimen/glass_touch_target"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_glass_clickable"
        android:clickable="true"
        android:contentDescription="@string/close"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_baseline_arrow_back" />
    <TextView
        android:id="@+id/activity_bar_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.ClashGlass.Title" />
</LinearLayout>
